<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="PCcell"
            android:src="@drawable/ic_pccell_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:text="PCcell"
            android:textColor="#FAFAFA"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="○ Desconectado"
            android:textColor="#A1A1AA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Card de Conexão -->
    <LinearLayout
        android:id="@+id/connectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ipEditText"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="IP do PC (ex: 192.168.15.11)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FAFAFA"
                android:textColorHint="#52525B"
                android:textSize="13sp" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="96dp"
                android:paddingHorizontal="16dp"
                android:stateListAnimator="@null"
                android:text="Conectar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Botão de Descoberta Automática -->
        <Button
            android:id="@+id/discoverButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@null"
            android:text="Buscar PC na rede"
            android:textAllCaps="false"
            android:textColor="#93C5FD"
            android:textSize="12sp" />

        <!-- Banner de PC Encontrado -->
        <LinearLayout
            android:id="@+id/discoveredBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_banner_discovery"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/discoveredText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="PC encontrado"
                android:textColor="#D1FAE5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/connectDiscoveredButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null"
                android:text="Conectar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Área de Chat e Atividade -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_feed_container"
        android:clipToPadding="false"
        android:padding="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatMessagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/welcomeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="36dp"
                android:text="Conecte-se ao computador para trocar mensagens, enviar arquivos e controlar periféricos."
                android:textColor="#71717A"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Progresso de Transferência -->
    <TextView
        android:id="@+id/progressTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:textColor="#93C5FD"
        android:textSize="11sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/transferProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progressBackgroundTint="#27272A"
        android:progressTint="#2563EB"
        android:visibility="gone" />

    <!-- Cabeçalho da Barra de Ferramentas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="CONTROLES"
            android:textColor="#71717A"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/allToolsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Ver todos"
            android:textColor="#60A5FA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Barra Minimalista de Ferramentas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/screenshotButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_monitor"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Tela 60Hz"
                android:textAllCaps="false"
                android:textColor="#FAFAFA"
                android:textSize="11sp" />

            <Button
                android:id="@+id/touchpadButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_touchpad"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Touchpad"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/gamepadButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_gamepad"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Gamepad"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/webcamButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_video"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Webcam"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/micButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_mic"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Microfone"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/attachButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_folder"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Arquivos"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/explorePcButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_folder_open"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Pastas PC"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/photoToClipboardButton"
                android:layout_width="82dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_camera_shot"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Foto Ctrl+V"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/clipboardButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_clipboard"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Clipboard"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/macroButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_macro"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Macros"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/powerButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_power"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Energia"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />

            <Button
                android:id="@+id/remoteButton"
                android:layout_width="78dp"
                android:layout_height="62dp"
                android:alpha="0.45"
                android:background="@drawable/bg_tool_tile"
                android:drawableTop="@drawable/ic_sliders"
                android:drawablePadding="5dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:stateListAnimator="@null"
                android:text="Mídia"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Barra de Digitação e Envio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/messageEditText"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:enabled="false"
            android:hint="Enviar mensagem ao PC..."
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:textColor="#FAFAFA"
            android:textColorHint="#52525B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:alpha="0.45"
            android:background="@drawable/bg_send_pill"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="20dp"
            android:stateListAnimator="@null"
            android:text="Enviar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
